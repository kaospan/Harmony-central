{
  "name": "harmony-central",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform music discovery app that connects songs by harmonic structure",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "dev:backend": "npm run dev -w @harmony-central/backend",
    "dev:mobile": "npm run dev -w @harmony-central/mobile"
  },
  "keywords": [
    "music",
    "harmony",
    "chord-progressions",
    "music-discovery"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
